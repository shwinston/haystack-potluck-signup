{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haystack-potluck-signup",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // RESET_CODE is set with `npx wrangler secret put RESET_CODE`.
  // It is not stored in this file. Local dev reads it from .dev.vars.
  "secrets": {
    "required": ["RESET_CODE"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haystack-potluck",
      // Replace this placeholder with the id printed by:
      //   npx wrangler d1 create haystack-potluck
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
